
exports.handler = async (event) => {
  try {
    if (event.httpMethod !== "GET") {
      return {
        statusCode: 405,
        body: JSON.stringify({ error: "Méthode non autorisée" })
      };
    }

    const apiKey = process.env.API_FOOTBALL_KEY;

    if (!apiKey) {
      return {
        statusCode: 500,
        body: JSON.stringify({ error: "Clé API non configurée" })
      };
    }

    const fixture = event.queryStringParameters?.fixture;

    if (!fixture || !/^\d+$/.test(fixture)) {
      return {
        statusCode: 400,
        body: JSON.stringify({ error: "Match invalide" })
      };
    }

    const url = new URL(
      "https://v3.football.api-sports.io/odds"
    );

    url.searchParams.set("fixture", fixture);

    const response = await fetch(url, {
      headers: {
        "x-apisports-key": apiKey
      }
    });

    const data = await response.json();

    if (!response.ok) {
      return {
        statusCode: response.status,
        body: JSON.stringify({ error: "Erreur API Football" })
      };
    }

    const bookmakers = (data.response || []).flatMap(item =>
      (item.bookmakers || []).map(bookmaker => ({
        name: bookmaker.name,
        markets: (bookmaker.bets || []).map(bet => ({
          market: bet.name,
          odds: (bet.values || []).map(value => ({
            selection: value.value,
            odd: value.odd
          }))
        }))
      }))
    );

    return {
      statusCode: 200,
      headers: {
        "Content-Type": "application/json",
        "Cache-Control": "public, max-age=1800"
      },
      body: JSON.stringify({ bookmakers })
    };

  } catch (error) {
    return {
      statusCode: 500,
      body: JSON.stringify({
        error: "Impossible de récupérer les cotes"
      })
    };
  }
};
